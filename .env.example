# Public URL of this marketing site (canonical, OG, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Main AI Swarm app, where sign-up and sign-in live.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public support address used by the FAQ and footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@aiswarm.dev

# PostgreSQL connection used by Prisma and the waitlist server action.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Launch notification delivery. Verify the sender/domain in Resend first.
RESEND_API_KEY=re_your_api_key
LAUNCH_FROM_EMAIL=AI Swarm <launch@your-domain.com>

# Long random value. Vercel sends it as `Authorization: Bearer <value>`.
CRON_SECRET=replace-with-a-long-random-secret
